[Unit]
Description=Protocol Dashboard Gunicorn Application
After=network.target

[Service]
# Run as a normal non-root user (e.g., ubuntu)
User=<user>
Group=<user>

# Directory where the repository is cloned on your server
WorkingDirectory=/path/to/protocol-dashboard

# Ensure the virtualenv binaries and system tools (like ffmpeg) are on PATH
Environment="PATH=/path/to/protocol-dashboard/venv/bin:/usr/local/bin:/usr/bin:/bin"

# Load environment variables if .env exists
EnvironmentFile=-/path/to/protocol-dashboard/.env

# Start Gunicorn using the virtual environment and the existing gunicorn.conf.py
ExecStart=/path/to/protocol-dashboard/venv/bin/gunicorn -c gunicorn.conf.py app:app

# Restart automatically if the application crashes
Restart=always
RestartSec=5s

# Process management
KillMode=mixed
TimeoutStopSec=10
PrivateTmp=true

[Install]
WantedBy=multi-user.target
